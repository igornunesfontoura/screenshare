{
  "name": "screenshare",
  "private": true,
  "version": "0.1.2",
  "description": "Compartilhamento de tela P2P e watch party para Linux e Windows",
  "author": "Igor Nunes <igoralunomc@gmail.com>",
  "type": "module",
  "main": "out/main/index.js",
  "desktopName": "screenshare.desktop",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && npm run build:win-audio && electron-builder --win",
    "build:win-audio": "cargo build --release --manifest-path native/win-audio/Cargo.toml",
    "release": "npm version patch -m \"release: v%s\" && git push --follow-tags",
    "signal": "npm --prefix server start",
    "test:server": "npm --prefix server test",
    "test": "node --test shared/*.test.ts src/main/**/*.test.ts && npm --prefix server test",
    "test:win-audio": "cargo test --manifest-path native/win-audio/Cargo.toml",
    "smoke:linux": "node scripts/smoke.mjs release/${npm_package_version}/linux-unpacked/screenshare"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.66.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  },
  "allowScripts": {
    "electron-winstaller": false
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
